{
	"name": "svmd",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt --write .",
		"lint": "oxfmt --check . && oxlint ."
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.4",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"idb-keyval": "^6.3.0",
		"markdown-it": "^15.0.2",
		"shiki": "^4.5.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
