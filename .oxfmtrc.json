{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": false,
	"trailingComma": "none",
	"printWidth": 120,
	"sortImports": false,
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	"svelte": {
		"allowShorthand": false
	},
	"ignorePatterns": [
		"README.md",
		"worker-configuration.d.ts",
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"bun.lock",
		"bun.lockb",
		"/static/"
	]
}
